# Скопируй этот файл в .env и заполни своими значениями.
# .env никогда не должен попадать в git.

# Ключ Anthropic API — получить на console.anthropic.com (раздел API Keys).
# Без него игра будет работать (регистрация, лидерборд), но звонки/встречи с ИИ — нет.
ANTHROPIC_API_KEY=sk-ant-...

# Любая длинная случайная строка — для подписи сессий (можно сгенерировать: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string

# Порт (большинство хостингов подставляют свой через переменную PORT автоматически)
PORT=3000
